<?xml version="1.0"?>
<!-- Учебный полигон для ПР №8–10: комната 8 x 6 м, перегородки, препятствия, цветные цели.
     Старт робота: (-3.0, 0.0). Красный мяч: (3.0, -1.0). -->
<sdf version="1.9">
  <world name="lab_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.8 0.85 0.9 1</background>
      <shadows>false</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_north">
      <static>true</static>
      <pose>0 3.0 0.25 0 0 0.0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>8.2 0.1 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>8.2 0.1 0.5</size></box></geometry>
          <material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -3.0 0.25 0 0 0.0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>8.2 0.1 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>8.2 0.1 0.5</size></box></geometry>
          <material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>4.05 0 0.25 0 0 0.0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 6.0 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 6.0 0.5</size></box></geometry>
          <material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-4.05 0 0.25 0 0 0.0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 6.0 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 6.0 0.5</size></box></geometry>
          <material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material></visual>
      </link>
    </model>
    <model name="partition_1">
      <static>true</static>
      <pose>-1.0 1.5 0.25 0 0 0.0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 3.0 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 3.0 0.5</size></box></geometry>
          <material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material></visual>
      </link>
    </model>
    <model name="partition_2">
      <static>true</static>
      <pose>1.5 -1.6 0.25 0 0 0.0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 2.8 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 2.8 0.5</size></box></geometry>
          <material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material></visual>
      </link>
    </model>
    <model name="crate_1">
      <static>true</static>
      <pose>2.8 1.6 0.2 0 0 0.0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.6 0.6 0.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.6 0.6 0.4</size></box></geometry>
          <material><ambient>0.55 0.35 0.2 1</ambient><diffuse>0.55 0.35 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="crate_2">
      <static>true</static>
      <pose>-2.8 -1.8 0.2 0 0 0.5</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.8 0.5 0.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.8 0.5 0.4</size></box></geometry>
          <material><ambient>0.55 0.35 0.2 1</ambient><diffuse>0.55 0.35 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="pillar_1">
      <static>true</static>
      <pose>0.3 0.6 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.15</radius><length>0.6</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.15</radius><length>0.6</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
      </link>
    </model>
    <model name="pillar_2">
      <static>true</static>
      <pose>-2.5 2.2 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.15</radius><length>0.6</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.15</radius><length>0.6</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
      </link>
    </model>
    <model name="red_ball">
      <pose>3.0 -1.0 0.12 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.2</mass><inertia><ixx>0.001152</ixx><iyy>0.001152</iyy><izz>0.001152</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><sphere><radius>0.12</radius></sphere></geometry></collision>
        <visual name="visual"><geometry><sphere><radius>0.12</radius></sphere></geometry>
          <material><ambient>0.9 0.05 0.05 1</ambient><diffuse>0.9 0.05 0.05 1</diffuse></material></visual>
      </link>
    </model>
    <model name="green_target">
      <static>true</static>
      <pose>-3.2 2.3 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.1</radius><length>0.3</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.1</radius><length>0.3</length></cylinder></geometry>
          <material><ambient>0.05 0.8 0.1 1</ambient><diffuse>0.05 0.8 0.1 1</diffuse></material></visual>
      </link>
    </model>
    <model name="blue_target">
      <static>true</static>
      <pose>3.3 2.4 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.1</radius><length>0.3</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.1</radius><length>0.3</length></cylinder></geometry>
          <material><ambient>0.05 0.2 0.9 1</ambient><diffuse>0.05 0.2 0.9 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
